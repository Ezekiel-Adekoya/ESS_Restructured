summarise(BIOMASS = sum(BIOMASS), .groups = "drop") %>% # to avoid domination by a spikes in biomass
group_by(Phase) %>%
mutate(Pct = BIOMASS / sum(BIOMASS)) %>%
ungroup() %>%
arrange(Phase, desc(Pct)) %>%
group_by(Phase) %>%
mutate(
Rank   = row_number(),
CumPct = cumsum(Pct)
