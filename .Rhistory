catchability = 0.1
)
# 3. Update your main gear_params table
# (Remove old Fixed_Gear rows and bind these new ones)
gear_params <- gear_params %>%
filter(gear != "Fixed_Gear") %>%
bind_rows(fixed_gear_update, halibut_update)
gear_params
mizer_effort_matrix
