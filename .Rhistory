ggplot(plot_data_total, aes(x = Year, y = Effort_Raw, fill = Gear)) +
geom_area(position = "stack", alpha = 0.8, color = "white", size = 0.1) +
scale_fill_manual(values = c(
"Bottom_Trawl" = "#E41A1C", # Red
"Fixed_Gear"   = "#4DAF4A", # Green
"Small_Mesh"   = "#984EA3", # Purple
"Pelagic"      = "#377EB8"  # Blue
)) +
theme_minimal() +
labs(
title = "Total Cumulative Fishing Effort in 4VsW",
subtitle = "Actual Volume of Effort (Total kW-Days per Year)",
x = "Year",
y = "Total Ecosystem Effort (kW-Days)",
fill = "Gear Group"
) +
scale_y_continuous(labels = scales::label_number(suffix = "M", scale = 1e-6)) + # In Millions
theme(legend.position = "bottom")
ggplot(plot_data, aes(x = Year, y = Effort, color = Gear)) +
geom_line() +
geom_point(alpha = 0.5) +
theme_minimal() +
labs(
title = "Fishing Effort by Functional Gear Group in 4VsW",
subtitle = "Effort standardized by Vessel Power (kW-Days)",
x = "Year",
y = "Standardized Effort (0-1 Scale)",
color = "Gear Group"
) +
scale_y_continuous(labels = scales::comma) +
facet_wrap(~Gear, scales = "free_y") # Use free_y to see trends in smaller fisheries
selected_spp_names <- c("COD(ATLANTIC)", "HADDOCK", "REDFISH UNSEPARATED",
"AMERICAN PLAICE", "SILVER HAKE", "MONKFISH,GOOSEFISH,ANGLER",
"WHITE HAKE", "THORNY SKATE", "WINTER SKATE", "POLLOCK",
"YELLOWTAIL FLOUNDER", "LONGHORN SCULPIN", "SQUIRREL OR RED HAKE",
"HERRING(ATLANTIC)", "NORTHERN SAND LANCE", "SPINY DOGFISH",
"HALIBUT(ATLANTIC)")
# 2. Filter and Pivot
stratum_matrix <- stat %>%
# Filter only for your modeling species
filter(COMMON_NAME %in% selected_spp_names) %>%
group_by(STRAT, COMMON_NAME) %>%
summarise(biomass = sum(Biomass_Strata_KG, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = COMMON_NAME, values_from = biomass, values_fill = 0) %>%
# MOVE Stratum out of the data columns and into the row labels
column_to_rownames("STRAT")
stat <- read.csv("Ess_data/LF_Biomass_Abund.csv")
selected_spp_names <- c("COD(ATLANTIC)", "HADDOCK", "REDFISH UNSEPARATED",
"AMERICAN PLAICE", "SILVER HAKE", "MONKFISH,GOOSEFISH,ANGLER",
"WHITE HAKE", "THORNY SKATE", "WINTER SKATE", "POLLOCK",
"YELLOWTAIL FLOUNDER", "LONGHORN SCULPIN", "SQUIRREL OR RED HAKE",
"HERRING(ATLANTIC)", "NORTHERN SAND LANCE", "SPINY DOGFISH",
"HALIBUT(ATLANTIC)")
# 2. Filter and Pivot
stratum_matrix <- stat %>%
# Filter only for your modeling species
filter(COMMON_NAME %in% selected_spp_names) %>%
group_by(STRAT, COMMON_NAME) %>%
summarise(biomass = sum(Biomass_Strata_KG, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = COMMON_NAME, values_from = biomass, values_fill = 0) %>%
# MOVE Stratum out of the data columns and into the row labels
column_to_rownames("STRAT")
# 3. Calculate Overlap (Schoener's D)
# Normalize each species' total biomass across the strata/year snapshots to 1
dist_norm <- sweep(stratum_matrix, 2, colSums(stratum_matrix), "/")
# Calculate interaction matrix
inter_matrix <- 1 - (as.matrix(dist(t(dist_norm), method = "manhattan")) / 2)
diag(inter_matrix) <- 1
# 4. Generate Dendrogram
d <- as.dist(1 - inter_matrix)
fit <- hclust(d, method = "ward.D2")
plot(fit, main = "4VsW Spatial Associations: Selected 18 Species",
xlab = "", sub = "Clustered by Depth Stratum Overlap", hang = -1)
biomass_overlap <- stat %>%
filter(!is.na(STRAT), STRAT != "") %>%
filter(suppressWarnings(as.numeric(STRAT)) >= 444, # exclude 4vN
suppressWarnings(as.numeric(STRAT)) <= 466) %>%
filter(SPEC < 1000) %>%
group_by(STRAT, COMMON_NAME) %>%
summarise(Biomass = sum(Biomass_Strata_KG, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = COMMON_NAME, values_from = Biomass, values_fill = 0)
# Remove Year/Stratum columns for the math
#select(-YEAR, -STRAT)
# 2. Normalize: Species distributions across all observations (sum to 1)
# This ensures a "dominant" species doesn't skew the overlap math
dist_norm <- sweep(stratum_matrix, 2, colSums(stratum_matrix), "/")
# 3. Calculate Schoener's D (Percentage Overlap)
# Manhattan distance / 2 gives the difference; 1 minus that gives the overlap
inter_matrix <- 1 - (as.matrix(dist(t(dist_norm), method = "manhattan")) / 2)
# 4. Cleanup: Ensure the diagonal is exactly 1
diag(inter_matrix) <- 1
# Convert to a distance object (1 - overlap)
# High overlap = Low distance
d <- as.dist(1 - inter_matrix)
# Hierarchical Clustering using Ward's method (minimizes variance within clusters)
fit <- hclust(d, method = "ward.D2")
# Plot with a horizontal line to suggest 'guilds'
plot(fit, main = "4VsW Species Associations by Depth Stratum",
xlab = "", sub = "Based on Schoener's D Overlap", ylab = "Ecological Distance")
abline(h = 0.5, col = "red", lty = 2) # Threshold for distinct guilds
# 1. Add rectangles to the dendrogram to highlight the clusters
# 'h = 0.5' matches your red line; alternatively use 'k = 4' for four main guilds
rect.hclust(fit, h = 0.5, border = "blue")
# 2. Extract which species belong to which cluster (useful for your interaction matrix)
clusters <- cutree(fit, h = 0.5)
print(clusters) # Shows the guild assignment for each of your 18 species
# 3. (Optional) Create a more modern Cluster Plot using ggplot2
library(factoextra)
fviz_dend(fit, h = 0.5,                 # Set threshold
type = "rectangle",           # Or use "phylogenic" for a circular plot
rect = TRUE,                  # Add rectangles
rect_fill = TRUE,             # Fill rectangles with colour
k_colors = "jco",             # Colour palette
cex = 0.6,                    # Label size
main = "4VsW Ecological Guilds (Depth Stratum Overlap)")
biomass_overlap
# Plot with a horizontal line to suggest 'guilds'
plot(fit, main = "4VsW Species Associations by Depth Stratum",
xlab = "", sub = "Based on Schoener's D Overlap", ylab = "Ecological Distance")
# 1. Add rectangles to the dendrogram to highlight the clusters
# 'h = 0.5' matches your red line; alternatively use 'k = 4' for four main guilds
rect.hclust(fit, h = 0.5, border = "blue")
# 2. Extract which species belong to which cluster (useful for your interaction matrix)
clusters <- cutree(fit, h = 0.5)
print(clusters) # Shows the guild assignment for each of your 18 species
fviz_dend(fit, h = 0.5,                 # Set threshold
type = "rectangle",           # Or use "phylogenic" for a circular plot
rect = TRUE,                  # Add rectangles
rect_fill = TRUE,             # Fill rectangles with colour
k_colors = "jco",             # Colour palette
cex = 0.6,                    # Label size
main = "4VsW Ecological Guilds (Depth Stratum Overlap)")
library(tidyverse)
library(tidyr)
library(scales)
library(patchwork)
stat <- read.csv("Ess_data/LF_Biomass_Abund.csv")
biomass_wide <- stat %>%
filter(!is.na(STRAT), STRAT != "") %>%
filter(suppressWarnings(as.numeric(STRAT)) >= 444,
suppressWarnings(as.numeric(STRAT)) <= 466) %>%
filter(SPEC < 1000) %>%
group_by(YEAR, COMMON_NAME) %>%
summarise(
Biomass_Strata_KG = sum(Biomass_Strata_KG, na.rm = TRUE),
.groups = "drop") %>%
pivot_wider(
names_from  = COMMON_NAME,
values_from = Biomass_Strata_KG,
values_fill = 0) %>% arrange(YEAR)
write.csv(biomass_wide, "Ess_data/DFO_Biomas_all_species", row.names = FALSE)
write.csv(biomass_wide, "Ess_data/DFO_Biomas_all_species", row.names = FALSE)
PHASE_REF  <- "1979–1992 (Reference Period)"
PHASE_POST <- "1993–2025 (Post-Moratorium Period)"
# ─────────────────────────────────────────────
# 4. LONG PHASE DATA
# ─────────────────────────────────────────────
long_df_phase <- biomass_wide %>%
filter(between(YEAR, 1979, 2025)) %>%
mutate(Phase = factor(
if_else(YEAR <= 1992, PHASE_REF, PHASE_POST),levels = c(PHASE_REF, PHASE_POST))) %>%
pivot_longer(-c(YEAR, Phase), names_to = "Species", values_to = "BIOMASS") %>%
filter(!is.na(BIOMASS), BIOMASS > 0) %>% group_by(Species) %>% filter(n() >= 5) %>%
ungroup()
# ─────────────────────────────────────────────
# 5. PHASE PERCENTAGE SUMMARY
# ─────────────────────────────────────────────
phase_pct <- long_df_phase %>%
group_by(Phase, Species) %>%
summarise(BIOMASS = sum(BIOMASS), .groups = "drop") %>%
group_by(Phase) %>% mutate(Pct = BIOMASS / sum(BIOMASS)) %>%
ungroup() %>% arrange(Phase, desc(Pct)) %>%
group_by(Phase) %>% mutate(Rank   = row_number(), CumPct = cumsum(Pct)) %>%
filter(is.finite(Pct)) %>% mutate(Species = str_to_sentence(str_squish(Species))) %>%
ungroup()
# ─────────────────────────────────────────────
# 6. COLOUR PALETTE  — keyed to phase constants
# ─────────────────────────────────────────────
pal <- c(
`1979–1992 (Reference Period)`      = "#E07B2A",
`1993–2025 (Post-Moratorium Period)` = "#2471A3")
# ─────────────────────────────────────────────
# 7. PLOT FUNCTION
# ─────────────────────────────────────────────
make_phase_plot <- function(ph, df = phase_pct) {
col <- pal[[ph]]
df_ph <- df %>%
filter(Phase == ph) %>%
mutate(Species = factor(Species, levels = rev(unique(Species))))
# 95 % cumulative cut-off
cut_rank <- df_ph %>% filter(CumPct >= 0.95) %>% slice(1) %>% pull(Rank)
if (length(cut_rank) == 0 || !is.finite(cut_rank)) cut_rank <- nrow(df_ph)
df_ph <- df_ph %>% mutate(Above95 = Rank <= cut_rank)
ypos <- as.numeric(df_ph$Species[df_ph$Rank == cut_rank][1]) - 0.5
ggplot(df_ph, aes(Pct, Species)) +
annotate("rect",
xmin = -Inf, xmax = Inf, ymin = ypos, ymax = Inf,
fill = col, alpha = 0.06) +
geom_col(aes(alpha = Above95),
fill = col, colour = "white", linewidth = 0.2, width = 0.85) +
scale_alpha_manual(values = c("TRUE" = 0.85, "FALSE" = 0.35), guide = "none") +
geom_hline(yintercept = ypos, colour = col, linetype = "dashed", linewidth = 0.7) +
annotate("label",
x = Inf, y = ypos,
label   = "← 95% cumulative biomass",
colour  = col, fill = "white",
label.padding = unit(0.18, "lines"),
hjust = 1.05, vjust = -0.3,
size = 2.6, fontface = "bold") +
scale_x_continuous(labels = percent_format(accuracy = 1),expand = expansion(mult = c(0, 0.30))) +
labs(title = ph, x = "% of total biomass", y = NULL) +
theme_classic(base_size = 10, base_family = "serif") +
theme(
panel.border       = element_rect(colour = col, fill = NA, linewidth = 1.1),
plot.background    = element_rect(fill = "white", colour = col, linewidth = 0.4),
plot.title         = element_text(face = "bold", size = 10, colour = col,
margin = margin(b = 6)),
axis.text.y        = element_text(size = 7.5, colour = "grey15"),
axis.text.x        = element_text(size = 7.0, colour = "grey40"),
axis.title.x       = element_text(size = 7.5, colour = "grey40", margin = margin(t = 4)),
axis.ticks         = element_line(colour = "grey70", linewidth = 0.3),
axis.line          = element_blank(),
panel.grid.major.x = element_line(colour = "grey92", linewidth = 0.3),
panel.grid.major.y = element_blank(),
panel.grid.minor   = element_blank(),
plot.margin        = margin(10, 16, 10, 10)
)
}
p <- make_phase_plot(PHASE_REF) +
make_phase_plot(PHASE_POST) +
plot_layout(ncol = 2) +
plot_annotation(
#title    = "Scotian Shelf Groundfish Community Biomass Composition",
theme = theme(
plot.title = element_text(face = "bold", size = 13, family = "serif", hjust = 0.5, margin = margin(b = 4)),
plot.subtitle = element_text(colour = "grey45", size = 9, family = "serif",hjust = 0.5, margin = margin(b = 12)),
plot.background = element_rect(fill = "white", colour = NA)))
p
