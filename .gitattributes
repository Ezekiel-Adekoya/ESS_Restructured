# Auto detect text files and perform LF normalization
* text=auto
*.rds filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
add filter=lfs diff=lfs merge=lfs -text
*.zipgit filter=lfs diff=lfs merge=lfs -text
lfs filter=lfs diff=lfs merge=lfs -text
track filter=lfs diff=lfs merge=lfs -text
Ess_data/fhpd.csv filter=lfs diff=lfs merge=lfs -text
Ess_data/fhpy.csv filter=lfs diff=lfs merge=lfs -text
* !text !filter !merge !diff
