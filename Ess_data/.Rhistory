library(rfishbase)
library(tidyverse)
species <- c(
"Hippoglossoides platessoides", "Gadus morhua", "Clupea harengus",
"Hippoglossus hippoglossus", "Sebastes fasciatus",
"Reinhardtius hippoglossoides", "Melanogrammus aeglefinus",
"Ammodytes americanus", "Merluccius bilinearis", "Squalus acanthias",
"Urophycis tenuis", "Glyptocephalus cynoglossus",
"Limanda ferruginea"  # accepted FishBase name for yellowtail flounder
)
# Get a & b parameters, take first record per species to avoid duplicates
length_weight <- rfishbase::estimate(species) |>
select(Species, a, b) |>
filter(!is.na(a), !is.na(b)) |>
group_by(Species) |>
slice(1) |>
ungroup()
